{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Identifiant unique dans tout le dossier contenu/"
    },
    "titre": {
      "type": "string",
      "minLength": 3,
      "description": "Titre affiché de la série"
    },
    "domaine": {
      "type": "string",
      "enum": [
        "acces-lexical",
        "vitesse",
        "memoire-travail",
        "memoire-episodique",
        "attention",
        "flexibilite"
      ],
      "description": "Domaine cognitif principal sollicité"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Incrémentez-la quand vous modifiez une série existante"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "discrimination"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Identifiant unique dans tout le dossier contenu/"
          },
          "nature": {
            "type": "string",
            "enum": [
              "quasi-synonyme",
              "paronyme"
            ]
          },
          "phrase": {
            "type": "string",
            "minLength": 10,
            "description": "Phrase avec un emplacement « ___ » pour le mot à choisir"
          },
          "options": {
            "minItems": 2,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Mots proposés, dont la réponse"
          },
          "reponse": {
            "type": "string",
            "minLength": 1
          },
          "explication": {
            "type": "string",
            "minLength": 10,
            "description": "Distinction de sens, affichée après la réponse"
          },
          "difficulte": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 = très facile, 5 = très difficile"
          }
        },
        "required": [
          "id",
          "nature",
          "phrase",
          "options",
          "reponse",
          "explication",
          "difficulte"
        ]
      }
    }
  },
  "required": [
    "id",
    "titre",
    "domaine",
    "version",
    "type",
    "items"
  ]
}
