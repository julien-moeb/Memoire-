{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Identifiant unique dans tout le dossier contenu/"
    },
    "titre": {
      "type": "string",
      "minLength": 3,
      "description": "Titre affiché de la série"
    },
    "domaine": {
      "type": "string",
      "enum": [
        "acces-lexical",
        "vitesse",
        "memoire-travail",
        "memoire-episodique",
        "attention",
        "flexibilite"
      ],
      "description": "Domaine cognitif principal sollicité"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Incrémentez-la quand vous modifiez une série existante"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "paragraphe"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Identifiant unique dans tout le dossier contenu/"
          },
          "titre": {
            "type": "string",
            "minLength": 3
          },
          "texte": {
            "type": "string",
            "minLength": 200
          },
          "unites": {
            "minItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            },
            "description": "Idées clés à retrouver au rappel libre (mots-clés)"
          },
          "questions": {
            "minItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string",
                  "minLength": 5
                },
                "reponse": {
                  "type": "string",
                  "minLength": 1
                },
                "variantes": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "question",
                "reponse"
              ]
            },
            "description": "Questions du rappel indicé"
          },
          "difficulte": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 = très facile, 5 = très difficile"
          }
        },
        "required": [
          "id",
          "titre",
          "texte",
          "unites",
          "questions",
          "difficulte"
        ]
      }
    }
  },
  "required": [
    "id",
    "titre",
    "domaine",
    "version",
    "type",
    "items"
  ]
}
