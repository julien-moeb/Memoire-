{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Identifiant unique dans tout le dossier contenu/"
    },
    "titre": {
      "type": "string",
      "minLength": 3,
      "description": "Titre affiché de la série"
    },
    "domaine": {
      "type": "string",
      "enum": [
        "acces-lexical",
        "vitesse",
        "memoire-travail",
        "memoire-episodique",
        "attention",
        "flexibilite"
      ],
      "description": "Domaine cognitif principal sollicité"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Incrémentez-la quand vous modifiez une série existante"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "decision-lexicale"
    },
    "mots": {
      "minItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "pseudoMots": {
      "minItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2
      },
      "description": "Suites prononçables qui ne sont pas des mots français"
    }
  },
  "required": [
    "id",
    "titre",
    "domaine",
    "version",
    "type",
    "mots",
    "pseudoMots"
  ]
}
