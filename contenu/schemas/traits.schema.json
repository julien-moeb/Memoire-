{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Identifiant unique dans tout le dossier contenu/"
    },
    "titre": {
      "type": "string",
      "minLength": 3,
      "description": "Titre affiché de la série"
    },
    "domaine": {
      "type": "string",
      "enum": [
        "acces-lexical",
        "vitesse",
        "memoire-travail",
        "memoire-episodique",
        "attention",
        "flexibilite"
      ],
      "description": "Domaine cognitif principal sollicité"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Incrémentez-la quand vous modifiez une série existante"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "traits"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Identifiant unique dans tout le dossier contenu/"
          },
          "mot": {
            "type": "string",
            "minLength": 1
          },
          "traits": {
            "type": "object",
            "properties": {
              "categorie": {
                "type": "string",
                "minLength": 2,
                "description": "À quelle catégorie appartient-il ?"
              },
              "usage": {
                "type": "string",
                "minLength": 2,
                "description": "À quoi sert-il ?"
              },
              "description": {
                "type": "string",
                "minLength": 2,
                "description": "À quoi ressemble-t-il ? (forme, matière, propriétés)"
              },
              "lieu": {
                "type": "string",
                "minLength": 2,
                "description": "Où le trouve-t-on ?"
              },
              "association": {
                "type": "string",
                "minLength": 2,
                "description": "À quoi vous fait-il penser ?"
              }
            },
            "required": [
              "categorie",
              "usage",
              "description",
              "lieu",
              "association"
            ]
          },
          "difficulte": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 = très facile, 5 = très difficile"
          }
        },
        "required": [
          "id",
          "mot",
          "traits",
          "difficulte"
        ]
      }
    }
  },
  "required": [
    "id",
    "titre",
    "domaine",
    "version",
    "type",
    "items"
  ]
}
