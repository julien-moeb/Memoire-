{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Identifiant unique dans tout le dossier contenu/"
    },
    "titre": {
      "type": "string",
      "minLength": 3,
      "description": "Titre affiché de la série"
    },
    "domaine": {
      "type": "string",
      "enum": [
        "acces-lexical",
        "vitesse",
        "memoire-travail",
        "memoire-episodique",
        "attention",
        "flexibilite"
      ],
      "description": "Domaine cognitif principal sollicité"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Incrémentez-la quand vous modifiez une série existante"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "fluence"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Identifiant unique dans tout le dossier contenu/"
          },
          "modalite": {
            "type": "string",
            "enum": [
              "semantique",
              "phonemique"
            ]
          },
          "consigne": {
            "type": "string",
            "minLength": 3,
            "description": "Ex. « Des animaux » ou « Des mots commençant par P »"
          },
          "cle": {
            "type": "string",
            "minLength": 1,
            "description": "Catégorie (semantique) ou lettre initiale (phonemique)"
          },
          "reference": {
            "default": [],
            "description": "Mots valides connus ; un mot absent est soumis à votre arbitrage",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclusions": {
            "default": [],
            "description": "Mots à refuser (hors catégorie fréquents)",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reserveBilan": {
            "default": false,
            "description": "true = réservée au bilan, jamais proposée en entraînement",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "modalite",
          "consigne",
          "cle"
        ]
      }
    }
  },
  "required": [
    "id",
    "titre",
    "domaine",
    "version",
    "type",
    "items"
  ]
}
