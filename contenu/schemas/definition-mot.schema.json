{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Identifiant unique dans tout le dossier contenu/"
    },
    "titre": {
      "type": "string",
      "minLength": 3,
      "description": "Titre affiché de la série"
    },
    "domaine": {
      "type": "string",
      "enum": [
        "acces-lexical",
        "vitesse",
        "memoire-travail",
        "memoire-episodique",
        "attention",
        "flexibilite"
      ],
      "description": "Domaine cognitif principal sollicité"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Incrémentez-la quand vous modifiez une série existante"
    },
    "description": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "const": "definition-mot"
    },
    "items": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Identifiant unique dans tout le dossier contenu/"
          },
          "definition": {
            "type": "string",
            "minLength": 10,
            "description": "Définition précise, sans contenir le mot attendu"
          },
          "reponse": {
            "type": "string",
            "minLength": 1,
            "description": "Terme attendu"
          },
          "variantes": {
            "default": [],
            "description": "Autres réponses acceptées",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "indices": {
            "type": "object",
            "properties": {
              "trait": {
                "type": "string",
                "minLength": 3,
                "description": "Premier indice : un trait sémantique (catégorie, usage, contexte)"
              },
              "syllabe": {
                "type": "string",
                "minLength": 1,
                "description": "Second indice : début du mot, qui doit en être le préfixe exact"
              }
            },
            "required": [
              "trait",
              "syllabe"
            ]
          },
          "difficulte": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 = très facile, 5 = très difficile"
          }
        },
        "required": [
          "id",
          "definition",
          "reponse",
          "indices",
          "difficulte"
        ]
      }
    }
  },
  "required": [
    "id",
    "titre",
    "domaine",
    "version",
    "type",
    "items"
  ]
}
