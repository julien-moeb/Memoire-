  "definitions": [
    {
      "id": "bil-c-01",
      "definition": "Instrument qui mesure la pression atmosphérique.",
      "reponse": "baromètre",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; il aide à prévoir le temps.",
        "syllabe": "ba"
      },
      "difficulte": 2
    },
    {
      "id": "bil-c-02",
      "definition": "Lunette d'approche portative permettant d'observer des objets éloignés.",
      "reponse": "longue-vue",
      "variantes": [
        "longue vue"
      ],
      "indices": {
        "trait": "Nom féminin ; instrument du marin ou du guetteur.",
        "syllabe": "lon"
      },
      "difficulte": 3
    },
    {
      "id": "bil-c-03",
      "definition": "Petit instrument de musique à anches, que l'on fait glisser contre les lèvres en soufflant.",
      "reponse": "harmonica",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; instrument de poche du blues.",
        "syllabe": "har"
      },
      "difficulte": 2
    },
    {
      "id": "bil-c-04",
      "definition": "Tristesse vague et durable, sans cause précise.",
      "reponse": "mélancolie",
      "variantes": [],
      "indices": {
        "trait": "Nom féminin ; état d'âme cher aux poètes romantiques.",
        "syllabe": "mé"
      },
      "difficulte": 3
    },
    {
      "id": "bil-c-05",
      "definition": "Ensemble de clés réunies par un anneau.",
      "reponse": "trousseau",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; se dit aussi du linge d'une mariée.",
        "syllabe": "trou"
      },
      "difficulte": 3
    },
    {
      "id": "bil-c-06",
      "definition": "Petite caisse montée sur une roue, munie de deux brancards, pour transporter des charges.",
      "reponse": "brouette",
      "variantes": [],
      "indices": {
        "trait": "Nom féminin ; outil de jardin ou de chantier.",
        "syllabe": "brou"
      },
      "difficulte": 2
    },
    {
      "id": "bil-c-07",
      "definition": "Embouchure large d'un fleuve, où la marée se fait sentir.",
      "reponse": "estuaire",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; celui de la Gironde est le plus vaste d'Europe occidentale.",
        "syllabe": "es"
      },
      "difficulte": 3
    },
    {
      "id": "bil-c-08",
      "definition": "Ustensile percé de trous, servant à égoutter les aliments.",
      "reponse": "passoire",
      "variantes": [],
      "indices": {
        "trait": "Nom féminin ; on y verse les pâtes.",
        "syllabe": "pa"
      },
      "difficulte": 2
    },
    {
      "id": "bil-c-09",
      "definition": "Affirmation qui semble contraire au bon sens ou à la logique, tout en pouvant être vraie.",
      "reponse": "paradoxe",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; contradiction apparente.",
        "syllabe": "pa"
      },
      "difficulte": 4
    },
    {
      "id": "bil-c-10",
      "definition": "Tour élevée portant une puissante lumière pour guider les navires la nuit.",
      "reponse": "phare",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; se dit aussi des feux avant d'une voiture.",
        "syllabe": "pha"
      },
      "difficulte": 2
    },
    {
      "id": "bil-c-11",
      "definition": "Qui relève d'un idéal séduisant mais irréalisable.",
      "reponse": "utopique",
      "variantes": [],
      "indices": {
        "trait": "Adjectif ; dérivé d'un mot inventé par Thomas More.",
        "syllabe": "u"
      },
      "difficulte": 4
