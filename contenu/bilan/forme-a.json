  "definitions": [
    {
      "id": "bil-a-01",
      "definition": "Instrument formé de deux ampoules de verre reliées, où s'écoule du sable pour mesurer une durée.",
      "reponse": "sablier",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; objet ancien de mesure du temps.",
        "syllabe": "sa"
      },
      "difficulte": 2
    },
    {
      "id": "bil-a-02",
      "definition": "Instrument dont l'aiguille aimantée indique le nord.",
      "reponse": "boussole",
      "variantes": [],
      "indices": {
        "trait": "Nom féminin ; utile en randonnée et en navigation.",
        "syllabe": "bou"
      },
      "difficulte": 2
    },
    {
      "id": "bil-a-03",
      "definition": "Instrument qui permet au médecin d'écouter les bruits du cœur et des poumons.",
      "reponse": "stéthoscope",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; le médecin le porte souvent autour du cou.",
        "syllabe": "sté"
      },
      "difficulte": 3
    },
    {
      "id": "bil-a-04",
      "definition": "Regret mélancolique d'une époque passée ou d'un lieu quitté.",
      "reponse": "nostalgie",
      "variantes": [],
      "indices": {
        "trait": "Nom féminin ; sentiment tourné vers le passé.",
        "syllabe": "nos"
      },
      "difficulte": 3
    },
    {
      "id": "bil-a-05",
      "definition": "Petit escalier portatif à quelques marches.",
      "reponse": "escabeau",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; sert à atteindre une étagère haute.",
        "syllabe": "es"
      },
      "difficulte": 3
    },
    {
      "id": "bil-a-06",
      "definition": "Toile ou filet suspendu par ses extrémités, dans lequel on s'allonge.",
      "reponse": "hamac",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; on l'accroche entre deux arbres.",
        "syllabe": "ha"
      },
      "difficulte": 2
    },
    {
      "id": "bil-a-07",
      "definition": "Ensemble d'îles proches les unes des autres.",
      "reponse": "archipel",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; terme de géographie.",
        "syllabe": "ar"
      },
      "difficulte": 3
    },
    {
      "id": "bil-a-08",
      "definition": "Ustensile conique servant à verser un liquide dans un récipient à goulot étroit.",
      "reponse": "entonnoir",
      "variantes": [],
      "indices": {
        "trait": "Nom masculin ; ustensile de cuisine ou d'atelier.",
        "syllabe": "en"
      },
      "difficulte": 3
    },
    {
      "id": "bil-a-09",
      "definition": "Manque de ce qui est nécessaire.",
      "reponse": "pénurie",
      "variantes": [],
      "indices": {
        "trait": "Nom féminin ; se dit par exemple de carburant ou de personnel.",
        "syllabe": "pé"
      },
      "difficulte": 4
    },
    {
      "id": "bil-a-10",
      "definition": "Plaque mobile placée en hauteur, qui indique la direction du vent.",
      "reponse": "girouette",
      "variantes": [],
      "indices": {
        "trait": "Nom féminin ; se dit aussi d'une personne qui change souvent d'avis.",
        "syllabe": "gi"
      },
      "difficulte": 3
    },
    {
      "id": "bil-a-11",
      "definition": "Qui doute de ce qui est généralement admis ou de ce qu'on lui affirme.",
